# IronFit Fitness Studio — Environment Variables Example
PORT=3000
ADMIN_PASSWORD=ironfit2026

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# Client Mirrored Keys
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Owner Notification Target
OWNER_NOTIFICATION_EMAIL=owner@example.com

# Email Delivery - Option 1: Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="IronFit Studio <onboarding@resend.dev>"

# Email Delivery - Option 2: SMTP (Gmail App Password, Brevo, SendGrid, Amazon SES)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
